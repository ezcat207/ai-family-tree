---
// 截图预览弹窗。任何带 data-snap="<卡片 id>" data-name="文件名" 的按钮都会触发。
import type { Locale } from '../lib/i18n';
interface Props { locale?: Locale; }
const { locale = 'zh' } = Astro.props;
const STR = locale === 'en' ? {
  generating: 'Rendering image…',
  preview: 'Share card preview',
  tip: 'On your phone, long-press the image to save it.',
  save: 'Save image',
  copy: 'Copy link',
  copied: 'Copied',
  copyPrompt: 'Copy this link:',
  close: 'Close',
  failed: 'Rendering failed — please try another browser.',
  defaultName: 'ai-family-tree.png',
} : {
  generating: '正在生成图片…',
  preview: '分享卡预览',
  tip: '手机上长按图片即可保存。',
  save: '保存图片',
  copy: '复制链接',
  copied: '已复制',
  copyPrompt: '复制这个链接：',
  close: '关闭',
  failed: '生成失败了，请换个浏览器再试一次。',
  defaultName: 'ai-family-tree.png',
};
---
<dialog id="snap-dialog">
  <p class="msg">{STR.generating}</p>
  <img alt={STR.preview} hidden />
  <p class="tip muted small" hidden>{STR.tip}</p>
  <div class="row">
    <a class="btn dl" hidden download>{STR.save}</a>
    <button class="btn ghost copy" type="button">{STR.copy}</button>
    <button class="btn ghost close" type="button">{STR.close}</button>
  </div>
</dialog>
<script define:vars={{ STR }}>
  import { render } from '../lib/snap';
  const dlg = document.getElementById('snap-dialog');
  const img = dlg.querySelector('img');
  const msg = dlg.querySelector('.msg');
  const tip = dlg.querySelector('.tip');
  const dl = dlg.querySelector('.dl');
  let link = location.href;
  dlg.querySelector('.close').addEventListener('click', () => dlg.close());
  dlg.querySelector('.copy').addEventListener('click', async (e) => {
    const b = e.currentTarget;
    try { await navigator.clipboard.writeText(link); b.textContent = STR.copied; } catch { prompt(STR.copyPrompt, link); }
  });
  document.addEventListener('click', async (e) => {
    const btn = e.target.closest('[data-snap]');
    if (!btn) return;
    const node = document.getElementById(btn.dataset.snap);
    if (!node) return;
    link = btn.dataset.link ? new URL(btn.dataset.link, location.href).href : location.href;
    dlg.querySelector('.copy').textContent = STR.copy;
    img.hidden = dl.hidden = tip.hidden = true;
    msg.hidden = false;
    msg.textContent = STR.generating;
    dlg.showModal();
    try {
      const url = await render(node);
      img.src = url;
      dl.href = url;
      dl.download = btn.dataset.name || STR.defaultName;
      img.hidden = dl.hidden = tip.hidden = false;
      msg.hidden = true;
      document.dispatchEvent(new CustomEvent('snap:done', { detail: { id: btn.dataset.snap } }));
    } catch (err) {
      console.error(err);
      msg.textContent = STR.failed;
    }
  });
</script>
<style>
  dialog { border: 1px solid var(--paper-dark); background: var(--paper); border-radius: 6px; padding: 1rem; max-width: min(92vw, 460px); width: 100%; }
  dialog::backdrop { background: rgba(34, 32, 28, .55); }
  img { width: 100%; height: auto; display: block; border: 1px solid var(--paper-dark); }
  .row { display: flex; gap: 8px; flex-wrap: wrap; margin-top: .8rem; }
  .msg { margin: .4rem 0; }
</style>
