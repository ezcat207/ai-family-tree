---
import { portraitSVG, logoPortraitSVG, type Variant } from '../lib/portrait';
interface Props {
  family: string;
  variant: Variant;
  color: string;
  dead?: boolean;
  uid: string;
  size?: number | string;
  label?: string;
  class?: string;
  /** auto：拟人形象 > 家徽 > 程序化兜底；crest：强制显示家徽（家族页顶部） */
  mode?: 'auto' | 'crest';
}
// 各家族的家徽：真实商标（public/avatars/family-*.svg），指称性使用，来源见 CREDITS.md。
export const FAMILY_CREST: Record<string, { src: string; w: number; h: number }> = {
  chatgpt: { src: '/avatars/family-chatgpt.svg', w: 150, h: 150 },
  claude: { src: '/avatars/family-claude.svg', w: 150, h: 150 },
  deepseek: { src: '/avatars/family-deepseek.svg', w: 150, h: 150 },
  doubao: { src: '/avatars/family-doubao.svg', w: 150, h: 150 },
  muse: { src: '/avatars/family-muse.svg', w: 200, h: 60 },
};
// 各家族成员的拟人形象（真实出处，见 CREDITS.md；社区二创已标注非官方）。
// 尚无可靠形象的家族回退到家徽，不再使用程序化假画像。
export const FAMILY_MASCOT: Record<string, { src: string; w: number; h: number }> = {
  claude: { src: '/avatars/mascot-claude.png', w: 200, h: 200 },
  deepseek: { src: '/avatars/mascot-deepseek.png', w: 160, h: 284 },
  muse: { src: '/avatars/mascot-muse.png', w: 200, h: 200 },
};
const { family, variant, color, dead = false, uid, size = 120, label = '', class: cls = '', mode = 'auto' } = Astro.props;
const mascot = mode === 'auto' ? FAMILY_MASCOT[family] : undefined;
const img = mascot ?? FAMILY_CREST[family];
const svg = img
  ? logoPortraitSVG({ logo: img.src, boxW: img.w, boxH: img.h, color, dead, uid })
  : portraitSVG({ family, variant, color, dead, uid });
const w = typeof size === 'number' ? `${size}px` : size;
---
<span class:list={['portrait', cls, { dead }]} style={`--w:${w}`} aria-label={label} role="img" set:html={svg} />
<style>
  .portrait { display: inline-block; width: var(--w); aspect-ratio: 240 / 300; line-height: 0; flex: none; }
  .portrait :global(svg) { width: 100%; height: 100%; display: block; }
</style>
