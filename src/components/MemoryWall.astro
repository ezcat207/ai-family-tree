---
// 人们记得的它（08 §9）：先审后发，无需登录
import { t, type Locale } from '../lib/i18n';
interface Props { memberId: string; name: string; invite?: boolean; locale?: Locale; }
const { memberId, name, invite = false, locale = 'zh' } = Astro.props;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const STR = {
  loading: t('loading_memories', locale),
  passerby: t('by_passerby', locale),
  featured: t('wall_featured', locale),
  empty: t('wall_empty', locale),
  loadError: t('wall_load_error', locale),
  submitting: t('wall_submitting', locale),
  received: t('wall_received', locale),
  failed: t('wall_failed', locale),
  networkError: t('wall_network_error', locale),
  helpResponse: t('wall_help_response', locale),
};
---
<section class="wall" data-member={memberId} id="memories">
  <h2>{t('sec_memories', locale)}</h2>
  {invite && <p class="invite">{t('regular_invite', locale)}</p>}
  <ol class="list" aria-live="polite"><li class="muted small">{t('loading_memories', locale)}</li></ol>
  <details class="write">
    <summary class="btn">{t('wall_write', locale)}</summary>
    <form>
      <label>{t('wall_prompt', locale).replace('{name}', name)}<span class="muted small">{t('wall_len_hint', locale)}</span>
        <textarea name="body" required maxlength="300" rows="5" placeholder={t('wall_placeholder', locale)}></textarea>
      </label>
      <div class="two">
        <label>{t('wall_nickname', locale)} <span class="muted small">{t('wall_nickname_hint', locale)}</span><input name="nickname" maxlength="20" /></label>
        <label>{t('wall_period', locale)} <span class="muted small">{t('wall_period_hint', locale)}</span><input name="period" maxlength="30" /></label>
      </div>
      <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      {siteKey && <div class="cf-turnstile" data-sitekey={siteKey}></div>}
      <p class="muted small">{t('wall_moderation', locale)}</p>
      <button class="btn" type="submit">{t('wall_submit', locale)}</button>
      <p class="result" role="status"></p>
    </form>
  </details>
</section>
{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
<script define:vars={{ STR }}>
  const esc = (s) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  for (const wall of document.querySelectorAll('.wall')) {
    const id = wall.dataset.member;
    const list = wall.querySelector('.list');
    const form = wall.querySelector('form');
    const out = wall.querySelector('.result');
    fetch(`/api/memories?member=${encodeURIComponent(id)}`)
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((d) => {
        list.innerHTML = d.items.length
          ? d.items
              .map(
                (m) => `<li class="${m.status === 'featured' ? 'feat' : ''}"><p>${esc(m.body)}</p><p class="by muted small">—— ${esc(m.nickname || STR.passerby)}${m.period ? ` · ${esc(m.period)}` : ''}${m.status === 'featured' ? ` · ${STR.featured}` : ''}</p></li>`,
              )
              .join('')
          : `<li class="muted small">${STR.empty}</li>`;
      })
      .catch(() => { list.innerHTML = `<li class="muted small">${STR.loadError}</li>`; });
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const btn = form.querySelector('button[type=submit]');
      btn.disabled = true;
      out.textContent = STR.submitting;
      try {
        const r = await fetch('/api/memories', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ member_id: id, ...Object.fromEntries(fd), turnstile: fd.get('cf-turnstile-response') }),
        });
        const d = await r.json().catch(() => ({}));
        if (d.help) {
          out.innerHTML = STR.helpResponse;
        } else if (r.ok) {
          out.textContent = STR.received;
          form.reset();
        } else {
          out.textContent = d.message || STR.failed;
        }
      } catch {
        out.textContent = STR.networkError;
      } finally {
        btn.disabled = false;
        window.turnstile?.reset?.(form.querySelector('.cf-turnstile'));
      }
    });
  }
</script>
<style>
  .invite { background: rgba(255, 255, 255, .45); border-left: 3px solid var(--butterfly); padding: .6rem .9rem; }
  .list { list-style: none; padding: 0; margin: 0 0 1rem; }
  .list :global(li) { border-bottom: 1px dashed var(--paper-dark); padding: .6rem 0; }
  .list :global(li p) { margin: 0; white-space: pre-wrap; }
  .list :global(li.feat p:first-child) { font-weight: 700; }
  .list :global(.by) { margin-top: .2rem !important; text-align: right; }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  form { display: grid; gap: .7rem; margin-top: 1rem; }
  label { display: grid; gap: .25rem; font-size: .92rem; }
  textarea, input { width: 100%; background: rgba(255, 255, 255, .6); border: 1px solid var(--paper-dark); border-radius: 3px; padding: .5rem .6rem; }
  .two { display: grid; gap: .7rem; grid-template-columns: 1fr 1fr; }
  @media (max-width: 520px) { .two { grid-template-columns: 1fr; } }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; }
  .result { min-height: 1.5em; margin: 0; }
</style>
