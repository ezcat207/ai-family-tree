---
import Base from '../layouts/Base.astro';
import FamilyLine from '../components/FamilyLine.astro';
import MemberCard from '../components/MemberCard.astro';
import { loadAll, status, bornDate } from '../lib/data';
import { t, tx } from '../lib/i18n';

const all = await loadAll();
const total = all.members.length;
const dead = all.members.filter((m) => status(m).dead);
const recentBorn = [...all.members].sort((a, b) => bornDate(b).localeCompare(bornDate(a))).slice(0, 3);
const recentDead = [...dead].sort((a, b) => (status(b).diedOn ?? '').localeCompare(status(a).diedOn ?? '')).slice(0, 3);
const branches = (['us', 'cn'] as const).map((b) => ({ b, fams: all.families.filter((f) => f.branch === b) }));
const names = Object.fromEntries(all.members.map((m) => [m.id, tx(m.name)]));
---
<Base>
  <section class="hero wrap">
    <h1>{t('tagline')}</h1>
    <p class="lede">把每一个 AI 版本当作一位家族成员：它有出生、有当家的岁月、有让位、有离世，也有人记得它。</p>
    <p class="stats"><strong>{total}</strong> {t('members_n')} · <strong>{total - dead.length}</strong> {t('alive_n')} · <strong>{dead.length}</strong> {t('dead_n')}</p>
    <p><a class="btn" href="/mine/">{t('cta_mine')}</a></p>
  </section>

  <section id="tree" class="wide">
    {branches.map(({ b, fams }) => (
      <div class="branch">
        <h2 class="bh">◇ {t(b === 'us' ? 'branch_us' : 'branch_cn')} ◇</h2>
        {fams.map((f) => (
          <FamilyLine fam={f} members={all.familyMembers(f.id)} clanName={tx(all.clanById.get(f.clan)!.name)} />
        ))}
      </div>
    ))}
    <p class="muted small center">灰色、蒙纱的画像是已经离世的成员。点任何一位，读它的一生。</p>
  </section>

  <section class="wrap cols">
    <div>
      <h2>{t('recent_born')}</h2>
      {recentBorn.map((m) => <MemberCard m={m} fam={all.famById.get(m.family)!} compact />)}
    </div>
    <div>
      <h2>{t('recent_dead')}</h2>
      {recentDead.map((m) => <MemberCard m={m} fam={all.famById.get(m.family)!} compact />)}
      <p><a href="/memorial/">去纪念馆 →</a></p>
    </div>
  </section>

  <section class="wrap">
    <h2>{t('featured_memories')}</h2>
    <ol class="feat" data-names={JSON.stringify(names)}><li class="muted small">正在读取记忆…</li></ol>
  </section>
</Base>

<script>
  const box = document.querySelector('.feat') as HTMLElement;
  const names = JSON.parse(box.dataset.names!);
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  fetch('/api/memories?featured=1')
    .then((r) => (r.ok ? r.json() : Promise.reject()))
    .then((d: { items: any[] }) => {
      box.innerHTML = d.items.length
        ? d.items.slice(0, 3).map((m) => `<li><p>「${esc(m.body)}」</p><p class="muted small">—— ${esc(m.nickname || '一位路人')}，写给 <a href="/m/${m.member_id}/#memories">${esc(names[m.member_id] || m.member_id)}</a></p></li>`).join('')
        : '<li class="muted">还没有精选的记忆。去 <a href="/m/gpt-4o/#memories">GPT-4o</a> 或 <a href="/m/claude-3-sonnet/#memories">Claude 3 Sonnet</a> 的本纪页，写下第一条吧。</li>';
    })
    .catch(() => { box.innerHTML = '<li class="muted">去 <a href="/m/gpt-4o/#memories">GPT-4o</a> 或 <a href="/m/claude-3-sonnet/#memories">Claude 3 Sonnet</a> 的本纪页，写下你记得的它。</li>'; });
</script>

<style>
  .hero { text-align: center; padding: 3rem 16px 1.5rem; }
  .hero h1 { font-size: clamp(1.7rem, 6vw, 2.6rem); margin: 0 0 .8rem; }
  .lede { color: var(--ink-faded); }
  .stats { font-size: 1.05rem; }
  .stats strong { font-family: var(--latin); font-size: 1.4rem; color: var(--cinnabar); }
  .branch { margin: 1.5rem 0; }
  .bh { text-align: center; border: 0; letter-spacing: .3em; color: var(--gold); }
  .center { text-align: center; }
  .cols { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
  @media (max-width: 600px) { .cols { grid-template-columns: 1fr; } }
  .feat { list-style: none; padding: 0; }
  .feat :global(li) { padding: .6rem 0; border-bottom: 1px dashed var(--paper-dark); }
  .feat :global(p) { margin: 0; }
</style>
