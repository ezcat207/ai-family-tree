---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { renderMd } from '../../lib/markdown';
import { fmt } from '../../lib/data';
import LongImage from '../../components/LongImage.astro';
import ShareTools from '../../components/ShareTools.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((p) => ({ params: { slug: p.id }, props: { slug: p.id } }));
}
const { slug } = Astro.props;
const post = (await getCollection('blog')).find((p) => p.id === slug)!;
const html = await renderMd(post.body ?? '');
---
<Base title={post.data.title} description={post.data.description}>
  <article class="wrap">
    <p class="muted small kicker">AI 家谱 · 特辑</p>
    <h1>{post.data.title}</h1>
    {post.data.subtitle && <p class="sub">{post.data.subtitle}</p>}
    <p class="muted small latin">{fmt(post.data.date)}</p>
    {post.data.draft && <p class="draft small">本篇为 AI 初稿，尚待人工审阅；文中事实均附来源，可点编号核对。</p>}
    <div class="prose" set:html={html} />
    {slug === 'bainian-gudu' && (
      <section>
        <h2>特辑长图</h2>
        <p class="muted small">一张可以发到小红书、朋友圈的家族树长图。</p>
        <LongImage />
      </section>
    )}
  </article>
  <ShareTools />
</Base>
<style>
  h1 { margin: .2rem 0; font-size: clamp(1.6rem, 6vw, 2.3rem); }
  .kicker { margin-top: 2rem; letter-spacing: .3em; }
  .sub { font-size: 1.1rem; color: var(--ink-faded); margin: .2rem 0; }
  .draft { background: rgba(227, 178, 60, .15); border-left: 3px solid var(--butterfly); padding: .4rem .8rem; }
</style>
