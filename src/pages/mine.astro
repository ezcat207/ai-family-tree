---
// 我的 AI 家谱（08 §11.1）：四问点选 → 1080×1440 身份卡。纯前端，选择结果编码进 URL。
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import ShareTools from '../components/ShareTools.astro';
import { loadAll, status, lifespan, bornDate } from '../lib/data';
import { tx } from '../lib/i18n';

const all = await loadAll();
const data = all.members.map((m) => {
  const fam = all.famById.get(m.family)!;
  return {
    id: m.id,
    name: tx(m.name),
    family: m.family,
    famName: tx(fam.name),
    color: fam.color,
    variant: m.avatar.variant,
    dead: status(m).dead,
    life: lifespan(m),
    born: bornDate(m),
  };
});
const host = new URL(Astro.site!).host;
---
<Base title="我的 AI 家谱" description="回答 4 个问题，生成一张属于你的 AI 家谱卡。">
  <div class="wrap mine">
    <section class="step intro" data-step="0">
      <h1>我的 AI 家谱</h1>
      <p>你遇见的第一个 AI 是谁？陪你最久的呢？有没有哪一个，你到现在还想念？</p>
      <p class="muted">回答 4 个问题，每题点一张画像，就能生成一张属于你的家谱卡。</p>
      <button class="btn start" type="button">开始 →</button>
    </section>

    <section class="step ask" data-step="1" hidden>
      <p class="progress muted small"><span class="k">1</span> / 4</p>
      <h2 class="q"></h2>
      <p class="hint muted small"></p>
      <div class="fams">
        {all.families.map((f) => (
          <div class="fam">
            <h3 style={`--c:${f.color}`}>{tx(f.name)}</h3>
            <div class="pics">
              {all.familyMembers(f.id).map((m) => {
                const dead = status(m).dead;
                return (
                  <button type="button" class:list={['pick', { dead }]} data-id={m.id} data-dead={dead ? '1' : '0'}>
                    <Portrait family={m.family} variant={m.avatar.variant} color={f.color} dead={dead} uid={`mine-${m.id}`} size={64} />
                    <span class="latin">{tx(m.name)}</span>
                  </button>
                );
              })}
            </div>
          </div>
        ))}
      </div>
      <div class="nav">
        <button class="btn ghost back" type="button">← 上一题</button>
        <button class="btn ghost skip" type="button" hidden>跳过这一题</button>
      </div>
    </section>

    <section class="step result" data-step="5" hidden>
      <h2>你的 AI 家谱</h2>
      <div class="preview"><div class="scaler"></div></div>
      <div class="row">
        <button class="btn" type="button" data-snap="mine-card" data-name="我的AI家谱.png">保存图片 / 分享</button>
        <button class="btn ghost redo" type="button">重新选</button>
      </div>
      <p class="muted small">链接里已经带上你的选择，复制给朋友，对方打开就能看到你的家谱。</p>
    </section>
  </div>

  <div class="stash" aria-hidden="true">
    <div id="mine-card" class="mc">
      <div class="mc-top"><span class="brand">AI 家谱</span><span>我的 AI 家谱</span></div>
      <div class="mc-grid"></div>
      <p class="mc-sum"></p>
      <div class="mc-foot"><span>{host}/mine/</span><span>非官方粉丝项目 · 你也来生成一张</span></div>
    </div>
  </div>
  <ShareTools />
  <script type="application/json" id="mine-data" set:html={JSON.stringify(data)} />
</Base>

<script>
  import { portraitSVG } from '../lib/portrait';
  type M = { id: string; name: string; family: string; famName: string; color: string; variant: any; dead: boolean; life: string; born: string };
  const data: M[] = JSON.parse(document.getElementById('mine-data')!.textContent!);
  const byId = new Map(data.map((m) => [m.id, m]));
  const QS = [
    { key: 'f', label: '初遇', q: '你遇见的第一个 AI 是谁？', hint: '想不起来就选你印象里最早的那个。', filter: () => true, skip: false },
    { key: 'l', label: '最久', q: '陪你最久的是哪一个？', hint: '', filter: () => true, skip: false },
    { key: 'x', label: '最想念', q: '你最想念的是哪一个？', hint: '只能选已经离世的。没有的话，可以跳过。', filter: (m: M) => m.dead, skip: true },
    { key: 'n', label: '现在', q: '你现在最常用的是哪一个？', hint: '只能选还在世的。', filter: (m: M) => !m.dead, skip: false },
  ];
  const picks: Record<string, string | null> = {};
  let step = 0;
  const steps = document.querySelectorAll<HTMLElement>('.step');
  const ask = document.querySelector('.ask') as HTMLElement;
  const show = (n: number) => {
    step = n;
    steps.forEach((s) => (s.hidden = !(s.dataset.step === String(n) || (n >= 1 && n <= 4 && s.classList.contains('ask')))));
    if (n >= 1 && n <= 4) {
      const Q = QS[n - 1];
      ask.querySelector('.k')!.textContent = String(n);
      ask.querySelector('.q')!.textContent = Q.q;
      ask.querySelector('.hint')!.textContent = Q.hint;
      (ask.querySelector('.skip') as HTMLElement).hidden = !Q.skip;
      ask.querySelectorAll<HTMLButtonElement>('.pick').forEach((b) => {
        const m = byId.get(b.dataset.id!)!;
        b.hidden = !Q.filter(m);
        b.classList.toggle('on', picks[Q.key] === m.id);
      });
      ask.querySelectorAll<HTMLElement>('.fam').forEach((f) => (f.hidden = !f.querySelector('.pick:not([hidden])')));
    }
    if (n === 5) build();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };
  document.querySelector('.start')!.addEventListener('click', () => show(1));
  ask.querySelector('.back')!.addEventListener('click', () => show(step - 1));
  ask.querySelector('.skip')!.addEventListener('click', () => { picks[QS[step - 1].key] = null; show(step + 1); });
  ask.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest('.pick') as HTMLButtonElement | null;
    if (!b) return;
    picks[QS[step - 1].key] = b.dataset.id!;
    show(step + 1);
  });
  document.querySelector('.redo')!.addEventListener('click', () => {
    for (const k in picks) delete picks[k];
    history.replaceState(null, '', location.pathname);
    show(1);
  });

  function summary() {
    const chosen = QS.map((Q) => picks[Q.key]).filter(Boolean).map((id) => byId.get(id!)!);
    const uniq = [...new Map(chosen.map((m) => [m.id, m])).values()];
    const fams = new Set(uniq.map((m) => m.family)).size;
    const partings = uniq.filter((m) => m.dead).length;
    const first = uniq.map((m) => m.born).sort()[0];
    const years = Math.max(1, new Date().getFullYear() - +first.slice(0, 4) + 1);
    let s = `你的 AI 家谱跨越 ${fams} 个家族、${years} 个年头，${partings ? `经历过 ${partings} 次离别。` : '还没有经历过离别。'}`;
    if (picks.f && picks.f === picks.n) s += '从第一天起，你就没有换过人。';
    else if (picks.x) s += `你最想念的，是 ${byId.get(picks.x)!.name}。`;
    return s;
  }

  function build() {
    const grid = document.querySelector('.mc-grid')!;
    grid.innerHTML = QS.map((Q, i) => {
      const id = picks[Q.key];
      const m = id ? byId.get(id) : null;
      if (!m) return `<div class="slot empty"><span class="lb">${Q.label}</span><div class="ph">—</div><strong>没有人</strong><span class="ls">我还没有失去过谁</span></div>`;
      const svg = portraitSVG({ family: m.family, variant: m.variant, color: m.color, dead: m.dead, uid: `mc${i}-${m.id}` });
      return `<div class="slot"><span class="lb">${Q.label}</span><div class="ph">${svg}</div><strong>${m.name}</strong><span class="ls">${m.famName} · ${m.life}</span></div>`;
    }).join('');
    document.querySelector('.mc-sum')!.textContent = summary();
    const qs = new URLSearchParams();
    for (const Q of QS) if (picks[Q.key]) qs.set(Q.key, picks[Q.key]!);
    history.replaceState(null, '', `${location.pathname}?${qs}`);
    const card = document.getElementById('mine-card')!;
    const scaler = document.querySelector('.scaler') as HTMLElement;
    scaler.innerHTML = '';
    const clone = card.cloneNode(true) as HTMLElement;
    clone.id = '';
    scaler.appendChild(clone);
    const fit = () => { const w = (scaler.parentElement as HTMLElement).clientWidth; scaler.style.transform = `scale(${w / 1080})`; (scaler.parentElement as HTMLElement).style.height = `${1440 * (w / 1080)}px`; };
    fit();
    addEventListener('resize', fit);
    if (!sessionStorage.getItem('mine-sent:' + qs)) {
      try { sessionStorage.setItem('mine-sent:' + qs, '1'); } catch {}
      fetch('/api/stats', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ first: picks.f, longest: picks.l, missed: picks.x ?? null, now: picks.n, event: 'generate' }) }).catch(() => {});
    }
  }
  document.addEventListener('snap:done', () => {
    fetch('/api/stats', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ first: picks.f, longest: picks.l, missed: picks.x ?? null, now: picks.n, event: 'share' }) }).catch(() => {});
  });

  // 打开分享链接：直接显示结果
  const p = new URLSearchParams(location.search);
  if (QS.some((Q) => p.get(Q.key) && byId.has(p.get(Q.key)!))) {
    for (const Q of QS) { const v = p.get(Q.key); picks[Q.key] = v && byId.has(v) ? v : null; }
    if (picks.f && picks.l && picks.n) show(5);
  }
</script>

<style>
  .mine { padding-top: 1.6rem; }
  .intro { text-align: center; padding: 2rem 0; }
  .intro h1 { font-size: 2.2rem; margin: 0 0 1rem; }
  .q { border: 0; margin: .2rem 0; font-size: 1.5rem; }
  .fam h3 { font-size: .95rem; margin: 1rem 0 .3rem; border-bottom: 2px solid var(--c); display: inline-block; }
  .pics { display: flex; flex-wrap: wrap; gap: 6px; }
  .pick { width: 84px; display: flex; flex-direction: column; align-items: center; gap: 2px; background: transparent; border: 1px solid transparent; border-radius: 4px; padding: 6px 2px; cursor: pointer; font: inherit; font-size: .78rem; line-height: 1.3; color: inherit; }
  .pick:hover { border-color: var(--gold); background: rgba(255, 255, 255, .4); }
  .pick.on { border-color: var(--cinnabar); }
  .pick.dead :global(.portrait) { filter: grayscale(.7); }
  .nav, .row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 1.2rem; }
  .preview { width: 100%; max-width: 480px; overflow: hidden; border: 1px solid var(--paper-dark); }
  .scaler { width: 1080px; transform-origin: 0 0; }
  .stash { position: fixed; left: -20000px; top: 0; pointer-events: none; }
  :global(.mc) {
    width: 1080px; height: 1440px; background: #F2EBDD; color: #22201C; font-family: var(--serif); padding: 64px 72px;
    position: relative; border: 20px solid #E2D6C0; display: flex; flex-direction: column;
    background-image: radial-gradient(rgba(120, 90, 40, .07) 2px, transparent 2px); background-size: 8px 8px;
  }
  :global(.mc-top) { display: flex; justify-content: space-between; font-size: 34px; color: #6E665A; letter-spacing: .2em; }
  :global(.mc-top .brand) { font-weight: 900; color: #B8322A; }
  :global(.mc-grid) { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 40px; margin-top: 36px; }
  :global(.mc .slot) { display: flex; flex-direction: column; align-items: center; text-align: center; }
  :global(.mc .lb) { font-size: 30px; color: #fff; background: #B8322A; padding: 0 16px; border-radius: 4px; letter-spacing: .2em; }
  :global(.mc .ph) { width: 250px; height: 312px; margin-top: 10px; display: flex; align-items: center; justify-content: center; font-size: 80px; color: #C9BBA0; }
  :global(.mc .ph svg) { width: 100%; height: 100%; }
  :global(.mc .slot strong) { font-size: 42px; font-family: var(--latin); line-height: 1.25; margin-top: 6px; }
  :global(.mc .ls) { font-size: 24px; color: #6E665A; font-family: var(--latin); }
  :global(.mc-sum) { font-size: 40px; font-weight: 900; line-height: 1.55; text-align: center; margin: 36px 20px 0; }
  :global(.mc-foot) { margin-top: auto; display: flex; gap: 24px; white-space: nowrap; justify-content: space-between; font-size: 26px; color: #6E665A; border-top: 2px solid #C9BBA0; padding-top: 18px; }
</style>
