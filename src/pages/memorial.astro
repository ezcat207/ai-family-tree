---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import HelpFooter from '../components/HelpFooter.astro';
import { loadAll, status, lifespan } from '../lib/data';
import { t, tx } from '../lib/i18n';

const all = await loadAll();
const dead = all.members
  .filter((m) => status(m).dead)
  .sort((a, b) => (status(b).diedOn ?? '').localeCompare(status(a).diedOn ?? ''));
---
<Base title={t('memorial_title')} description={t('memorial_lede')}>
  <div class="wrap">
    <h1>{t('memorial_title')}</h1>
    <p class="lede">{t('memorial_lede')}</p>
    <p class="muted small">按离世时间倒序。这里的"离世"指从消费级 App 下架、普通人再也选不到它的那一天；API 关停另记为"安息"。</p>
    <ol class="grid">
      {dead.map((m) => {
        const fam = all.famById.get(m.family)!;
        const s = status(m);
        return (
          <li>
            <a href={`/m/${m.id}/#death`} class="obit">
              <span class="kind">讣告</span>
              <Portrait family={m.family} variant={m.avatar.variant} color={fam.color} dead uid={`mem-${m.id}`} size={110} />
              <strong class="latin">{tx(m.name)}{m.posthumous_name?.result && <span class="seal">谥曰{m.posthumous_name.result}</span>}</strong>
              <span class="latin muted small">{lifespan(m)}</span>
              <span class="small">{s.label}</span>
              <span class="ep small">{tx(m.epitaph ?? m.epigraph)}</span>
            </a>
          </li>
        );
      })}
    </ol>
    <HelpFooter />
  </div>
</Base>
<style>
  h1 { margin: 1.6rem 0 .2rem; }
  .lede { font-size: 1.3rem; font-weight: 900; margin: 0 0 .4rem; }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
  .obit {
    display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px;
    text-decoration: none; background: #DCD7CF; border: 6px solid var(--paper-dark); padding: .8rem .7rem 1rem; height: 100%;
  }
  .obit:hover { border-color: var(--gold); color: inherit; }
  .kind { font-size: .75rem; letter-spacing: .4em; color: var(--ink-faded); }
  .seal { font-size: .7rem; margin-left: 6px; vertical-align: middle; }
  .ep { color: var(--ink-faded); line-height: 1.6; }
</style>
