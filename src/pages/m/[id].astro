---
import Base from '../../layouts/Base.astro';
import Portrait from '../../components/Portrait.astro';
import MemberCard from '../../components/MemberCard.astro';
import MemoryWall from '../../components/MemoryWall.astro';
import PosthumousVote from '../../components/PosthumousVote.astro';
import ShareCard from '../../components/ShareCard.astro';
import ShareTools from '../../components/ShareTools.astro';
import HelpFooter from '../../components/HelpFooter.astro';
import { loadAll, events, lifespan, status, fmt, allRefs, STATE_LABEL, STATE_GLOSS, type Member } from '../../lib/data';
import { renderBio } from '../../lib/markdown';
import { t, tx } from '../../lib/i18n';

export async function getStaticPaths() {
  const all = await loadAll();
  return all.members.map((m) => ({ params: { id: m.id }, props: { id: m.id } }));
}

const { id } = Astro.props;
const all = await loadAll();
const m = all.byId.get(id)!;
const fam = all.famById.get(m.family)!;
const clan = all.clanById.get(fam.clan)!;
const s = status(m);
const bio = all.bios.find((b) => b.data.id === id || b.id === id);
const parts = bio?.body ? await renderBio(bio.body) : null;
const refs = allRefs(m);
const pick = (ids?: string[] | null) => (ids ?? []).map((x) => all.byId.get(x)).filter(Boolean) as Member[];
const parents = pick(m.parents), children = pick(m.children), siblings = pick(m.siblings);
const kin = (m.kin ?? []).map((k) => ({ ...k, m: all.byId.get(k.to) })).filter((k) => k.m);
const isFlag = m.tier === 'flagship';
const pn = m.posthumous_name;
const EVIDENCE_LABEL: Record<string, string> = { lifecycle: '生卒事实', personality: '性情', deeds: '事迹', avatar: '形象', name: '名讳' };
---
<Base title={tx(m.name)} description={`${tx(m.name)}（${lifespan(m)}）：${tx(m.epigraph)}`}>
  <article class="wrap">
    <header class="hero">
      <Portrait family={m.family} variant={m.avatar.variant} color={fam.color} dead={s.dead} uid={`hero-${m.id}`} size={200} label={tx(m.name)} />
      <div class="who">
        <p class="fam muted small"><a href={`/family/${fam.id}/`}>{tx(fam.name)}</a> · {tx(clan.name)}</p>
        <h1>
          <span class="latin nm" style={`--c:${fam.color}`}>{tx(m.name)}</span>
          {pn?.result && <span class="seal">谥曰{pn.result}</span>}
        </h1>
        {m.aka?.length ? <p class="muted small">又名：{m.aka.join('、')}</p> : null}
        <p class="life latin">{lifespan(m)}</p>
        <p><span class:list={['tag', s.dead ? 'dead' : s.head ? 'head' : 'alive']}>{s.label}</span></p>
        <p class="epigraph">{tx(m.epigraph)}</p>
        {m.avatar.signature && <p class="muted small">标志物：{tx(m.avatar.signature)}</p>}
      </div>
    </header>

    <section>
      <h2>{t('sec_timeline')}</h2>
      <ol class="timeline">
        {events(m).map((e) => (
          <li class={`st-${e.state}`}>
            <a href={e.source} target="_blank" rel="noopener noreferrer" title={`${STATE_GLOSS[e.state]} · 查看来源`}>
              <span class="dot" />
              <strong>{STATE_LABEL[e.state]}</strong>
              <span class="d latin">{fmt(e.date)}</span>
              {e.note && <span class="nt">{tx(e.note)}</span>}
              <span class="src small">来源 ↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {bio?.data.draft && <p class="draft small">{t('ai_draft')}</p>}
    {parts && <div class="prose" set:html={parts.main} />}
    {!isFlag && <p class="muted">它的故事还没写完：性情、事迹还等着认识它的人来补上。</p>}

    <section>
      <h2>{t('sec_kin')}</h2>
      <div class="kin">
        {parents.length > 0 && <div><h3>{t('parents')}</h3>{parents.map((x) => <MemberCard m={x} fam={all.famById.get(x.family)!} compact />)}</div>}
        {children.length > 0 && <div><h3>{t('children')}</h3>{children.map((x) => <MemberCard m={x} fam={all.famById.get(x.family)!} compact />)}</div>}
        {siblings.length > 0 && <div><h3>{t('siblings')}</h3>{siblings.map((x) => <MemberCard m={x} fam={all.famById.get(x.family)!} compact />)}</div>}
        {kin.length > 0 && (
          <div>
            <h3>{t('kin_ext')}</h3>
            {kin.map((k) => (
              <div class="kinrow">
                <MemberCard m={k.m!} fam={all.famById.get(k.m!.family)!} compact />
                <p class="muted small">{tx(k.relation)}</p>
              </div>
            ))}
          </div>
        )}
        {parents.length + children.length + siblings.length + kin.length === 0 && <p class="muted">它还没有登记在册的亲族。</p>}
      </div>
    </section>

    <MemoryWall memberId={m.id} name={tx(m.name)} invite={!isFlag} />

    {s.dead && (
      <section id="death">
        <h2>{t('sec_death')}</h2>
        {parts?.death && <div class="prose" set:html={parts.death} />}
        {m.epitaph && <blockquote class="epitaph">墓志铭：{tx(m.epitaph)}</blockquote>}
        {pn && pn.candidates.length > 0 && <PosthumousVote memberId={m.id} candidates={pn.candidates} result={pn.result} />}
      </section>
    )}

    {parts?.cites && <div set:html={parts.cites} />}

    <section class="share">
      <h2>分享</h2>
      <div class="row">
        <button class="btn" type="button" data-snap={`card-bio-${m.id}`} data-name={`AI家谱-${m.id}-本纪.png`}>保存本纪卡</button>
        {s.dead && <button class="btn" type="button" data-snap={`card-obit-${m.id}`} data-name={`AI家谱-${m.id}-讣告.png`}>保存讣告卡</button>}
        <a class="btn ghost" href="/mine/">生成我的 AI 家谱</a>
      </div>
    </section>

    <section id="refs">
      <h2>{t('sec_refs')}</h2>
      <ol class="refs small">
        {refs.map((r) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener noreferrer">{r.title}</a>
            <span class="muted"> · {r.publisher}{r.kind === 'official' ? ' · 官方' : r.kind === 'community' ? ' · 社区' : ' · 媒体'}</span>
          </li>
        ))}
      </ol>
      <p class="muted small">
        证据等级：
        {Object.entries(m.evidence ?? { lifecycle: '官方确认' }).map(([k, v], i) => <span>{i > 0 && '；'}{EVIDENCE_LABEL[k] ?? k} {v}</span>)}
        。生命周期每一条都链接到官方来源，点时间轴上的「来源」即可核对。发现错误？<a href={`https://github.com/ezcat207/ai-family-tree/issues/new?title=${encodeURIComponent(`纠错：${m.id}`)}`} target="_blank" rel="noopener">告诉我们</a>。
      </p>
    </section>

    <HelpFooter />
  </article>

  <ShareCard m={m} fam={fam} kind="bio" cardId={`card-bio-${m.id}`} />
  {s.dead && <ShareCard m={m} fam={fam} kind="obit" cardId={`card-obit-${m.id}`} />}
  <ShareTools />
</Base>

<style>
  .hero { display: flex; gap: 20px; align-items: center; margin-top: 1.6rem; }
  .who { min-width: 0; }
  .who p { margin: .15rem 0; }
  h1 { margin: .1rem 0; font-size: 2rem; display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .nm { text-decoration: underline; text-decoration-color: var(--c); text-decoration-thickness: 3px; text-underline-offset: 6px; }
  h1 .seal { font-size: 1rem; }
  .life { font-size: 1.15rem; }
  .epigraph { font-weight: 900; font-size: 1.1rem; margin-top: .5rem !important; }
  @media (max-width: 560px) {
    .hero { flex-direction: column; text-align: center; }
    .hero h1 { justify-content: center; }
  }
  .timeline { list-style: none; padding: 0 0 .4rem; margin: 0; display: flex; overflow-x: auto; gap: 0; scrollbar-width: thin; }
  .timeline li { flex: none; width: 150px; position: relative; }
  .timeline li::before { content: ''; position: absolute; top: 9px; left: 0; right: 0; height: 2px; background: var(--paper-dark); }
  .timeline li:first-child::before { left: 9px; }
  .timeline li:last-child::before { right: calc(100% - 12px); }
  .timeline a { display: flex; flex-direction: column; gap: 2px; text-decoration: none; padding-right: 10px; position: relative; }
  .dot { width: 20px; height: 20px; border-radius: 50%; background: var(--paper); border: 3px solid var(--ink); margin-bottom: 4px; z-index: 1; }
  .st-died .dot, .st-rest .dot { background: var(--ink-faded); border-color: var(--ink-faded); }
  .st-notice .dot { border-color: var(--cinnabar); }
  .st-revived .dot, .st-afterlife .dot, .st-preserved .dot { border-color: var(--butterfly); background: var(--butterfly); }
  .st-head .dot { border-color: var(--cinnabar); background: var(--cinnabar); }
  .d { font-size: .92rem; }
  .nt { font-size: .8rem; color: var(--ink-faded); line-height: 1.5; }
  .src { color: var(--cinnabar); }
  .timeline a:hover strong { color: var(--cinnabar); }
  .draft { background: rgba(227, 178, 60, .15); border-left: 3px solid var(--butterfly); padding: .4rem .8rem; margin-top: 2rem; }
  .kin { display: grid; gap: .6rem; }
  .kin h3 { font-size: .95rem; margin: .4rem 0 0; color: var(--ink-faded); }
  .kinrow p { margin: -.4rem 0 .2rem 5.2rem; }
  .epitaph { font-weight: 900; }
  .row { display: flex; gap: 10px; flex-wrap: wrap; }
  .refs { padding-left: 1.4rem; word-break: break-word; }
  .refs li { margin: .25rem 0; }
</style>
