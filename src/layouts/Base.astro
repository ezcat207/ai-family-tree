---
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/900.css';
import '@fontsource/eb-garamond/400.css';
import '../styles/global.css';
import { t } from '../lib/i18n';
interface Props { title?: string; description?: string; image?: string; }
const { title, description = t('tagline'), image } = Astro.props;
const fullTitle = title ? `${title} · ${t('site')}` : `${t('site')} · ${t('tagline')}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/#tree', label: t('nav_families') },
  { href: '/memorial/', label: t('nav_memorial') },
  { href: '/mine/', label: t('nav_mine') },
  { href: '/blog/bainian-gudu/', label: t('nav_blog') },
  { href: '/about/', label: t('nav_about') },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F2EBDD" />
  </head>
  <body>
    <header class="top">
      <div class="wide bar">
        <a class="brand" href="/">{t('site')}</a>
        <nav>
          {nav.map((n) => <a href={n.href} class:list={{ on: path.startsWith(n.href) && n.href !== '/#tree' }}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <div class="wide">
        <slot name="footer" />
        <p>{t('disclaimer')}</p>
        <p>
          <a href="/about/">关于与收录标准</a> · <a href="/about/#sources">数据来源说明</a> ·
          <a href="https://github.com/ezcat207/ai-family-tree" target="_blank" rel="noopener">GitHub</a> ·
          <a href="https://github.com/ezcat207/ai-family-tree/issues/new" target="_blank" rel="noopener">纠错</a>
        </p>
      </div>
    </footer>
  </body>
</html>
<style>
  .top { border-bottom: 1px solid var(--paper-dark); background: rgba(242, 235, 221, .92); position: sticky; top: 0; z-index: 10; backdrop-filter: blur(4px); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 52px; flex-wrap: wrap; }
  .brand { font-weight: 900; font-size: 1.2rem; text-decoration: none; letter-spacing: .1em; }
  nav { display: flex; gap: 14px; flex-wrap: wrap; font-size: .92rem; }
  nav a { text-decoration: none; color: var(--ink-faded); }
  nav a.on, nav a:hover { color: var(--cinnabar); }
  .foot { margin-top: 4rem; padding: 2rem 0 3rem; border-top: 1px solid var(--paper-dark); font-size: .82rem; color: var(--ink-faded); }
  .foot p { margin: .4rem 0; }
  @media (max-width: 520px) { nav { gap: 10px; font-size: .85rem; } .bar { padding-top: 6px; padding-bottom: 6px; } }
</style>
